# Generate .env with random passwords:  bash init-env.sh
# Or copy this file manually:           cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
DB_NAME=secure_clipboard
DB_USER=clipboard_user
DB_PASSWORD=CHANGE_ME
MYSQL_PORT=3306

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Application
SERVER_PORT=8080
CLIPBOARD_TTL_HOURS=24
CHUNK_SIZE=1048576
MAX_TEXT_SIZE=10485760
MAX_FILE_SIZE=524288000

# Spring profile (default, prod)
SPRING_PROFILES_ACTIVE=default

# Telegram bot (optional)
# Set TELEGRAM_ENABLED=true to activate daily statistics notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/telegram/webhook
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_REPORT_CRON='0 0 9 * * *'
